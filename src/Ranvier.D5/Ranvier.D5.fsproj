<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Ranvier.D5$(RanvierPackageSuffix)</PackageId>
    <Description>Functional visualization foundations for F#: data, scales, geometry, layouts and reactive scenes using Ranvier signals and Anime.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Contracts.fs" />
    <Compile Include="Data.fs" />
    <Compile Include="Statistics.fs" />
    <Compile Include="Scale.fs" />
    <Compile Include="TimeTicks.fs" />
    <Compile Include="Format.fs" /><Compile Include="Dsv.fs" />
    <Compile Include="Geometry.fs" />
    <Compile Include="Chord.fs" />
    <Compile Include="Ribbon.fs" />
    <Compile Include="Sankey.fs" />
    <Compile Include="Density.fs" />
    <Compile Include="Predicates.fs" />
    <Compile Include="Polygon.fs" />
    <Compile Include="Contour.fs" />
    <Compile Include="Hexbin.fs" />
    <Compile Include="Mark.fs" />
    <Compile Include="Chromatic.fs" />
    <Compile Include="SceneDefinitions.fs" />
    <Compile Include="SceneNode.fs" />
    <Compile Include="Scene.fs" />
    <Compile Include="Layout.fs" />
    <Compile Include="HierarchyIndex.fs" />
    <Compile Include="Tree.fs" />
    <Compile Include="Partition.fs" />
    <Compile Include="Treemap.fs" />
    <Compile Include="Pack.fs" />
    <Compile Include="Curves.fs" />
    <Compile Include="ShapeExtensions.fs" />
    <Compile Include="Stack.fs" />
    <Compile Include="Spatial.fs" />
    <Compile Include="Quadtree.fs" />
    <Compile Include="DelaunayKernel.fs" />
    <Compile Include="Delaunay.fs" />
    <Compile Include="Voronoi.fs" />
    <Compile Include="GraphData.fs" />
    <Compile Include="ForceKernels.fs" />
    <Compile Include="Force.fs" />
    <Compile Include="Reactive.fs" />
    <Compile Include="KeyedTransition.fs" />
    <Compile Include="Interaction.fs" />
    <Compile Include="Sampling.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Ranvier$(RanvierPackageSuffix)" Version="[0.1.1-preview.2]" />
    <PackageReference Include="Ranvier.Anime$(RanvierPackageSuffix)" Version="[0.1.0-rc.2]" />
    <PackageReference Include="Ranvier.Css$(RanvierPackageSuffix)" Version="[0.1.1-alpha.2]" />
    <None Include="../../tools/reference-fixtures/licenses/d3-sankey.txt" Pack="true" PackagePath="licenses/" />
    <None Include="../../tools/reference-fixtures/licenses/d3-chord.txt" Pack="true" PackagePath="licenses/" />
    <None Include="../../tools/reference-fixtures/licenses/d3-shape.txt" Pack="true" PackagePath="licenses/" />
    <None Include="../../tools/reference-fixtures/licenses/d3-scale-chromatic.txt" Pack="true" PackagePath="licenses/" />
    <None Include="../../tools/reference-fixtures/licenses/d3-hierarchy.txt" Pack="true" PackagePath="licenses/" />
    <None Include="../../tools/reference-fixtures/licenses/delaunator.txt" Pack="true" PackagePath="licenses/" />
    <None Include="../../tools/reference-fixtures/licenses/robust-predicates.txt" Pack="true" PackagePath="licenses/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
