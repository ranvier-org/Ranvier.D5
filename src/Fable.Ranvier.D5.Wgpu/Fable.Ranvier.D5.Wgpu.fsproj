<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Ranvier.D5.Wgpu</RootNamespace>
    <AssemblyName>Fable.Ranvier.D5.Wgpu</AssemblyName>
    <PackageId>Fable.Ranvier.D5.Wgpu$(RanvierPackageSuffix)</PackageId>
    <Description>Browser/Fable 3D and multi-dimensional visualization scales, axes, encodings, surfaces, volumes and Ranvier reactive GPU sinks over Fable.Ranvier.Wgpu.</Description>
    <DefineConstants>$(DefineConstants);FABLE_COMPILER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Ranvier.D5.Wgpu/Contracts3D.fs">
      <Link>./Contracts3D.fs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Fable.Ranvier.D5.Wgpu.fsproj" PackagePath="fable/" />
    <Content Include="../Ranvier.D5.Wgpu/*.fs" PackagePath="fable/" Visible="false" />
    <ProjectReference Include="../Ranvier.D5/Ranvier.D5.fsproj" />
    <PackageReference Include="Fable.Ranvier.Wgpu" Version="$(FableRanvierWgpuVersion)" />
    <PackageReference Update="FSharp.Core" Version="10.0.100" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
